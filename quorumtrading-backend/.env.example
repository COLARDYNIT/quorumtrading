# Backend dev environment — copy to `.env` in this directory and fill in what you need.
# Quarkus reads `.env` from the working directory, so this works with:
#   cd quorumtrading-backend && ./mvnw quarkus:dev
# Everything is OPTIONAL: without keys the backend boots on the mock broker,
# and LLM consensus can run through the local `claude` CLI (no API key needed).

# LLM provider (OpenRouter) — needed for hosted-model consensus and ./scripts/run-integration-tests.sh
OPENROUTER_API_KEY=

# Alpaca (US broker + market data) — paper keys are fine for development
ALPACA_API_KEY=
ALPACA_API_SECRET=

# Market data providers
FINNHUB_API_KEY=
TIINGO_API_TOKEN=

# Saxo (EU broker) — register your own dev app at developer.saxobank.com
SAXO_APP_KEY=
SAXO_APP_SECRET=

# Stripe (payments) — test-mode keys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Reddit sentiment source
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# AES-256-GCM key for encrypting stored broker credentials at rest (openssl rand -hex 32).
# A weak dev default exists — set a real one before storing any real broker credentials.
BROKER_CREDENTIALS_ENCRYPTION_KEY=
